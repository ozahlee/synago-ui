# Base URL of synago-backend's API (no trailing slash)
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000/api/v1
# ISO 4217 code used to format money
NEXT_PUBLIC_CURRENCY=UGX
# Shown in the sidebar and login page
NEXT_PUBLIC_CHURCH_NAME=SJW
# Country calling code used to build WhatsApp links from local numbers (0772… → 256772…)
NEXT_PUBLIC_PHONE_COUNTRY_CODE=256
